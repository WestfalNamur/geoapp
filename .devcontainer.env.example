# Copy to .devcontainer.env and fill in. Never commit the real file.
# These values are visible to all processes running as `dev` inside `app`.

# --- Postgres (consumed by the db service) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=postgres

# --- API keys (loaded as env vars in `app`) ---
ANTHROPIC_API_KEY=
OPENCODE_API_KEY=
